{
  "name": "justpostgres",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @justpostgres/control-plane --filter @justpostgres/web --parallel dev",
    "build": "pnpm --filter @justpostgres/web build && pnpm --filter @justpostgres/control-plane build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @justpostgres/control-plane db:generate",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  }
}
