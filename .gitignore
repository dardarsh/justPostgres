node_modules/
dist/
# Vite builds the UI straight into the control plane's static directory, and the
# Dockerfile builds it during the image build. Committing it would mean every UI
# change showing up twice in a diff.
apps/control-plane/public/
*.tsbuildinfo
.env
.env.local
# Anchored to the repository root. Unanchored, `data/` matches a directory of
# that name at ANY depth — which silently excluded apps/control-plane/src/data,
# seven source files, from every commit. The clone built locally and failed the
# moment anything checked it out fresh.
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
.DS_Store
